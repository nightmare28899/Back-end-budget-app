enum DetectedPurchaseStatus {
  PENDING
  CONFIRMED
  DISCARDED
}

enum DetectedPurchaseConfidence {
  HIGH
  MEDIUM
  LOW
}

model DetectedPurchase {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String @db.VarChar(256)
  sourcePackage String @db.VarChar(255)
  amountCents BigInt
  currency String @db.VarChar(3)
  merchant String? @db.VarChar(120)
  occurredAtMillis BigInt
  confidence DetectedPurchaseConfidence
  possibleDuplicateOf String? @db.VarChar(256)
  mayBeRegistered Boolean @default(false)
  status DetectedPurchaseStatus @default(PENDING)
  expenseId String?
  statementPaymentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId, status, occurredAtMillis])
  @@map("detected_purchases")
}
