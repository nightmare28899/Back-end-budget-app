generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BillingCycle {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
}

enum InstallmentFrequency {
  MONTHLY
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAW
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum StatementImportStatus {
  UPLOADED
  PARSED
  NEEDS_REVIEW
  CONFIRMED
  REVERTED
  FAILED
}

enum StatementSourceFormat {
  PDF
}

enum StatementSection {
  RECONCILIATION
  PAYMENT_TARGET
  CURRENT_CHARGES
  FINANCING_PLAN
  CFDI
  OTHER
}

enum StatementRowKind {
  CHARGE
  PAYMENT
  CREDIT
  INTEREST
  TAX
  REFINANCED_PRINCIPAL
  CFDI
  UNKNOWN
}

enum StatementRowDecision {
  PENDING
  INCLUDE_EXPENSE
  EXCLUDE
  INFO_ONLY
}

enum StatementReconciliationStatus {
  PENDING
  PASSED
  FAILED
}

enum StatementInstrumentKind {
  PHYSICAL
  DIGITAL
  UNKNOWN
}

enum StatementFinancingType {
  NO_INTEREST
  INTEREST_BEARING
  REFINANCED
}

enum StatementPaymentTargetKind {
  MINIMUM
  MINIMUM_PLUS_INSTALLMENTS
  NO_INTEREST
  OTHER
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  password             String
  name                 String
  role                 String          @default("user")
  avatarUrl            String?
  dailyBudget          Decimal         @default(0) @db.Decimal(10, 2)
  budgetAmount         Decimal         @default(0) @db.Decimal(10, 2)
  budgetPeriod         String          @default("daily")
  budgetPeriodStart    DateTime?
  budgetPeriodEnd      DateTime?
  currency             String          @default("MXN")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  isActive             Boolean         @default(true)
  isPremium            Boolean         @default(false)
  weeklyReportEnabled  Boolean         @default(true) @map("weekly_report_enabled")
  monthlyReportEnabled Boolean         @default(false) @map("monthly_report_enabled")
  termsAcceptedAt      DateTime?       @map("terms_accepted_at")
  termsVersion         String?         @map("terms_version")
  deletedAt            DateTime?       @map("deleted_at")
  categories           Category[]
  creditCards          CreditCard[]
  expenses             Expense[]
  incomes              Income[]
  subscriptions        Subscription[]
  savingsGoals         SavingsGoal[]
  deviceTokens         DeviceToken[]
  authSessions         AuthSession[]
  reportHistory        ReportHistory[]
  statementImports     StatementImport[]

  @@map("users")
}

model AuthSession {
  id                        String    @id @default(uuid())
  userId                    String
  currentRefreshTokenId     String    @map("current_refresh_token_id")
  previousRefreshTokenId    String?   @map("previous_refresh_token_id")
  previousRefreshTokenExpiresAt DateTime? @map("previous_refresh_token_expires_at")
  revokedAt                 DateTime? @map("revoked_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model ReportHistory {
  id            String   @id @default(uuid())
  periodType    String   @map("period_type")
  source        String   @default("manual")
  referenceDate DateTime @map("reference_date")
  reportStart   DateTime @map("report_start")
  reportEnd     DateTime @map("report_end")
  snapshot      Json
  userId        String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, periodType, referenceDate])
  @@map("report_history")
}

model CreditCard {
  id            String         @id @default(uuid())
  name          String
  bank          String
  brand         String
  last4         String
  color         String?
  creditLimit   Decimal?       @db.Decimal(10, 2)
  closingDay    Int?
  paymentDueDay Int?
  isActive      Boolean        @default(true)
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  expenses      Expense[]
  subscriptions Subscription[]
  statementImports StatementImport[]             @relation("StatementImportCreditCard")
  statementRows    StatementRow[]                @relation("StatementRowCreditCard")
  statementInstruments StatementInstrumentSnapshot[] @relation("StatementInstrumentCreditCard")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, name])
  @@map("credit_cards")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  icon         String?
  color        String?
  budgetAmount Decimal?  @map("budget_amount") @db.Decimal(10, 2)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  subscriptions Subscription[]
  statementRows StatementRow[]

  @@unique([userId, name])
  @@map("categories")
}

model Expense {
  id                          String                @id @default(uuid())
  title                       String
  merchantName                String?               @map("merchant_name")
  locationLabel               String?               @map("location_label")
  cost                        Decimal               @db.Decimal(10, 2)
  currency                    String                @default("MXN")
  paymentMethod               PaymentMethod         @default(CASH)
  creditCardId                String?
  isSubscription              Boolean               @default(false)
  subscriptionId              String?
  statementRowId              String?               @unique
  isInstallment               Boolean               @default(false)
  installmentGroupId          String?
  installmentCount            Int?
  installmentIndex            Int?
  installmentTotalAmount      Decimal?              @db.Decimal(10, 2)
  installmentFrequency        InstallmentFrequency?
  installmentPurchaseDate     DateTime?
  installmentFirstPaymentDate DateTime?
  imageUrl                    String?
  note                        String?
  date                        DateTime              @default(now())
  categoryId                  String?
  userId                      String
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  category                    Category?             @relation(fields: [categoryId], references: [id])
  creditCard                  CreditCard?           @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  subscription                Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  statementRow                StatementRow?         @relation(fields: [statementRowId], references: [id], onDelete: SetNull)
  user                        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, locationLabel, date])
  @@index([userId, merchantName, date])
  @@index([userId, isSubscription, date])
  @@index([userId, isInstallment, date])
  @@index([creditCardId])
  @@index([subscriptionId])
  @@index([installmentGroupId])
  @@map("expenses")
}

model StatementImport {
  id              String                @id @default(uuid())
  userId          String
  creditCardId    String?
  sourceFormat    StatementSourceFormat @default(PDF)
  sourceFileName  String?
  sourceMimeType  String
  sourceSizeBytes Int
  sourceSha256    String
  sourceObjectKey String?
  status          StatementImportStatus @default(UPLOADED)
  periodStart     DateTime?
  periodEnd       DateTime?
  parserVersion   String?
  version         Int                   @default(1)
  warningCount    Int                   @default(0)
  failureCode     String?
  failureMessage  String?
  parsedAt        DateTime?
  confirmedAt     DateTime?
  revertedAt      DateTime?
  isPaid          Boolean               @default(false)
  paidAt          DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard      CreditCard?           @relation("StatementImportCreditCard", fields: [creditCardId], references: [id], onDelete: SetNull)
  rows            StatementRow[]
  reconciliation  StatementReconciliation?
  paymentTargets  StatementPaymentTarget[]
  financingPlans  StatementFinancingPlan[]
  instruments     StatementInstrumentSnapshot[]

  @@unique([userId, sourceSha256])
  @@index([userId, status, createdAt])
  @@index([creditCardId])
  @@map("statement_imports")
}

model StatementRow {
  id                 String               @id @default(uuid())
  statementImportId  String
  occurrenceKey      String
  section            StatementSection
  sourceRowNumber    Int?
  position           Int
  transactionDate    DateTime?
  description        String
  merchantName       String?
  amount             Decimal              @db.Decimal(12, 2)
  currency           String               @default("MXN")
  kind               StatementRowKind
  decision           StatementRowDecision @default(PENDING)
  categoryId         String?
  linkedCreditCardId String?
  financingPlanId    String?
  warningCodes       Json?
  rawText             String?
  decisionNote       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  statementImport    StatementImport      @relation(fields: [statementImportId], references: [id], onDelete: Cascade)
  category           Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  linkedCreditCard   CreditCard?          @relation("StatementRowCreditCard", fields: [linkedCreditCardId], references: [id], onDelete: SetNull)
  financingPlan      StatementFinancingPlan? @relation(fields: [financingPlanId], references: [id], onDelete: SetNull)
  expense            Expense?

  @@unique([statementImportId, occurrenceKey])
  @@index([statementImportId, decision, position])
  @@index([categoryId])
  @@index([linkedCreditCardId])
  @@index([financingPlanId])
  @@map("statement_rows")
}

model StatementReconciliation {
  id                String                        @id @default(uuid())
  statementImportId String                        @unique
  openingBalance    Decimal                       @db.Decimal(12, 2)
  chargesTotal      Decimal                       @db.Decimal(12, 2)
  paymentsTotal     Decimal                       @db.Decimal(12, 2)
  creditsTotal      Decimal                       @db.Decimal(12, 2)
  closingBalance    Decimal                       @db.Decimal(12, 2)
  difference        Decimal                       @db.Decimal(12, 2)
  status            StatementReconciliationStatus @default(PENDING)
  message           String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  statementImport   StatementImport               @relation(fields: [statementImportId], references: [id], onDelete: Cascade)

  @@map("statement_reconciliations")
}

model StatementPaymentTarget {
  id                String                     @id @default(uuid())
  statementImportId String
  kind              StatementPaymentTargetKind
  label             String
  amount            Decimal                    @db.Decimal(12, 2)
  currency          String                     @default("MXN")
  dueDate           DateTime?
  sourceRowNumber   Int?
  position          Int
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  statementImport   StatementImport            @relation(fields: [statementImportId], references: [id], onDelete: Cascade)

  @@unique([statementImportId, position], map: "statement_targets_import_position_key")
  @@index([statementImportId, kind])
  @@map("statement_payment_targets")
}

model StatementInstrumentSnapshot {
  id                 String                  @id @default(uuid())
  statementImportId  String
  label              String
  kind               StatementInstrumentKind @default(UNKNOWN)
  last4              String?
  linkedCreditCardId String?
  position           Int
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  statementImport    StatementImport         @relation(fields: [statementImportId], references: [id], onDelete: Cascade)
  linkedCreditCard   CreditCard?             @relation("StatementInstrumentCreditCard", fields: [linkedCreditCardId], references: [id], onDelete: SetNull)
  financingPlans     StatementFinancingPlan[]

  @@unique([statementImportId, position], map: "statement_instruments_import_position_key")
  @@index([linkedCreditCardId])
  @@map("statement_instrument_snapshots")
}

model StatementFinancingPlan {
  id                   String                 @id @default(uuid())
  statementImportId    String
  instrumentSnapshotId String?
  type                 StatementFinancingType
  merchantName         String?
  purchaseDate         DateTime?
  originalAmount       Decimal?               @db.Decimal(12, 2)
  installmentAmount    Decimal?               @db.Decimal(12, 2)
  installmentNumber    Int?
  installmentCount     Int?
  remainingAmount      Decimal?               @db.Decimal(12, 2)
  currency             String                 @default("MXN")
  sourceRowNumber      Int?
  position             Int
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  statementImport      StatementImport        @relation(fields: [statementImportId], references: [id], onDelete: Cascade)
  instrumentSnapshot   StatementInstrumentSnapshot? @relation(fields: [instrumentSnapshotId], references: [id], onDelete: SetNull)
  rows                 StatementRow[]

  @@unique([statementImportId, position], map: "statement_plans_import_position_key")
  @@index([instrumentSnapshotId])
  @@map("statement_financing_plans")
}

model Income {
  id        String   @id @default(uuid())
  title     String
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("MXN")
  note      String?
  date      DateTime @default(now())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("incomes")
}

model Subscription {
  id                  String        @id @default(uuid())
  name                String
  cost                Decimal       @db.Decimal(10, 2)
  paymentMethod       PaymentMethod @default(CREDIT_CARD)
  creditCardId        String?
  currency            String        @default("MXN")
  billingCycle        BillingCycle  @default(MONTHLY)
  nextPaymentDate     DateTime
  reminderDays        Int           @default(3)
  lastReminderSentFor DateTime?
  isActive            Boolean       @default(true)
  logoUrl             String?
  hexColor            String?
  categoryId          String?
  userId              String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  creditCard          CreditCard?   @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  category            Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenses            Expense[]
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextPaymentDate])
  @@index([userId, isActive])
  @@index([creditCardId])
  @@index([userId, categoryId])
  @@map("subscriptions")
}

model DeviceToken {
  id         String         @id @default(uuid())
  token      String         @unique
  platform   DevicePlatform
  language   String         @default("en")
  userId     String
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model SavingsGoal {
  id            String               @id @default(uuid())
  title         String
  targetAmount  Decimal              @db.Decimal(10, 2)
  currentAmount Decimal              @default(0) @db.Decimal(10, 2)
  targetDate    DateTime?
  icon          String?
  color         String?
  userId        String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  SavingsTransaction[]

  @@index([userId, createdAt])
  @@map("savings_goals")
}

model SavingsTransaction {
  id        String                 @id @default(uuid())
  amount    Decimal                @db.Decimal(10, 2)
  type      SavingsTransactionType @default(DEPOSIT)
  goalId    String
  createdAt DateTime               @default(now())
  goal      SavingsGoal            @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@map("savings_transactions")
}
